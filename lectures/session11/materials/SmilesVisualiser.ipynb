    "smiles3 = \"\"\n",
    "mol_object_3 = Chem.MolFromSmiles(smiles3)\n",
    "mol_object_3 "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c4bdae30",
   "metadata": {},
   "source": [
    "The Mol object can be converted into a canonical Smiles using the MolToSmiles funcion."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "execution_count": 10,
   "id": "07496e10",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "'C1CN2CCC1CC2'"
      ]
     },
     "execution_count": 18,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "outputs": [
    {
     "data": {
      "text/plain": [
       "'N#CC1CCCCC1'"
      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "canonicalsmiles = Chem.MolToSmiles(mol_object)\n",
    "canonicalsmiles"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ebaba47f",
   "metadata": {},
   "source": [
    "To create an image, use the MolToImage function provided in Chem.Draw."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "execution_count": 11,
   "id": "032dd8f7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/jpeg": "",
      "image/png": "",
      "text/plain": [
       "<PIL.PngImagePlugin.PngImageFile image mode=RGB size=300x300>"
      ]
     },
     "execution_count": 19,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "outputs": [
    {
     "data": {
      "image/jpeg": "",
      "image/png": "",
      "text/plain": [
       "<PIL.PngImagePlugin.PngImageFile image mode=RGB size=300x300>"
      ]
     },
     "execution_count": 11,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "img = Draw.MolToImage(mol_object)  # Creates an Image from the Mol object.\n",
    "img"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "4f69b910",
   "metadata": {},
   "outputs": [],
   "source": [
    "img.save(\"molecule.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "362c4731",
   "metadata": {},
   "source": [
    "## Multiple entries\n",
    "\n",
    "Try the function MolsToGridImages to create a grid image from a list of Mols objects (SMILES need to be converted first!) and a list of names as legend."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "execution_count": 16,
   "id": "9918b8a8",
   "metadata": {},
   "outputs": [],
   "source": [
    "mols = []\n",
    "lst_smiles = [\"CCC\", \"COC\", \"CC(=O)O\"]\n",
    "names = [\"propane\", \"dimethyl ether\", \"acetic acid\"]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "execution_count": 17,
   "id": "144b731f",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[<rdkit.Chem.rdchem.Mol at 0x1e867b973e0>,\n",
       " <rdkit.Chem.rdchem.Mol at 0x1e867b97530>,\n",
       " <rdkit.Chem.rdchem.Mol at 0x1e867b975a0>]"
      ]
     },
     "execution_count": 23,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "for item in lst_smiles:\n",
    "    mols.append(Chem.MolFromSmiles(item))\n",
    "\n",
    "mols"
   ]
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[<rdkit.Chem.rdchem.Mol at 0x1242305f0>,\n",
       " <rdkit.Chem.rdchem.Mol at 0x124230ac0>,\n",
       " <rdkit.Chem.rdchem.Mol at 0x124230ba0>]"
      ]
     },
     "execution_count": 17,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "for item in lst_smiles:\n",
    "    mols.append(Chem.MolFromSmiles(item))\n",
    "    \n",
    "mols    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "execution_count": 18,
   "id": "ba6f9fc0",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<IPython.core.display.Image object>"
      ]
     },
     "execution_count": 24,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<IPython.core.display.Image object>"
      ]
     },
     "execution_count": 18,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "grid = Draw.MolsToGridImage(mols, legends=names)\n",
    "grid"
   ]
  },
