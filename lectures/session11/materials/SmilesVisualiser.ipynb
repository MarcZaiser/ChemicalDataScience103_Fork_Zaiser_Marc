   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "rdkit.Chem.rdchem.Mol"
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "type(mol_object)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "8fb850fd",
