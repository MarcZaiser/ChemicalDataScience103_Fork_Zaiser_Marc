   "source": [
    "from rdkit import Chem\n",
    "\n",
    "mol = Chem.MolFromXYZFile(\"yne.xyz\")\n",
    "conf = mol.GetConformer()\n",
    "\n",
    "atom_1_index = 0\n",
    "atom_2_index = 1\n",
    "dist = conf.GetAtomPosition(atom_1_index).Distance(conf.GetAtomPosition(atom_2_index))\n",
    "print(dist)"
   ]
