     ]
    }
   ],
   "source": [
    "# t-test\n",
    "\n",
    "t_value, p_value = stats.ttest_ind(group_high, group_low, equal_var=False, nan_policy=\"omit\")\n",
    "print(f\"t_value = {t_value:.2f}, p_value = {p_value:.6f}\")"
   ]
